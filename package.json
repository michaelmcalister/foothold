{
  "name": "foothold",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/catalogue.mjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply foothold --remote",
    "ios:init": "node scripts/ios.mjs init",
    "ios:sync": "node scripts/ios.mjs sync",
    "ios:icons": "node scripts/ios.mjs icons",
    "ios:open": "npx cap open ios",
    "android:init": "node scripts/android.mjs init",
    "android:sync": "node scripts/android.mjs sync",
    "android:icons": "node scripts/android.mjs icons",
    "android:open": "npx cap open android",
    "vapid": "node scripts/vapid.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelmcalister/foothold.git"
  },
  "bugs": {
    "url": "https://github.com/michaelmcalister/foothold/issues"
  },
  "homepage": "https://github.com/michaelmcalister/foothold#readme",
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.30.0",
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-firebase/messaging": "^8.6.0",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-speech-recognition": "^8.4.6",
    "firebase": "^12.19.0",
    "h3-js": "^4.5.0",
    "maplibre-gl": "^6.16.0",
    "posthog-js": "^1.438.21",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
