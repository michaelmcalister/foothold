{
  "appId": "au.net.mcalister.foothold",
  "appName": "Foothold",
  "webDir": "dist",
  "android": {
    "useLegacyBridge": true,
    "backgroundColor": "#16302A"
  },
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#16302A",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
